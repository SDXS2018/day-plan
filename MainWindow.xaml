<Window x:Class="DailyPlan.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:DailyPlan.ViewModels"
 xmlns:infra="clr-namespace:DailyPlan.Infrastructure"
 Title="plan" Width="120" Height="52" WindowStyle="None" ResizeMode="NoResize"
 AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
 UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource AppFont}"
 FontSize="17" FontWeight="Bold" TextOptions.TextFormattingMode="Display"
 Loaded="Window_Loaded" Deactivated="Window_Deactivated" Closing="Window_Closing"
 PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <infra:EmptyStringVisibilityConverter x:Key="EmptyStringVisibility" />
  <infra:TaskColorConverter x:Key="TaskColor" />
  <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
  <Style x:Key="LineIcon" TargetType="Path">
   <Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" />
   <Setter Property="Stretch" Value="Uniform" /><Setter Property="StrokeThickness" Value="1.5" />
   <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
   <Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" />
   <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>
  <Style x:Key="AddButton" BasedOn="{StaticResource IconButton}" TargetType="Button">
   <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
   <Setter Property="FocusVisualStyle" Value="{x:Null}" />
   <Setter Property="Foreground" Value="#5F77A9" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="ButtonMotion" RenderTransformOrigin="0.5,0.5">
     <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
     <Border Background="#15637DAF" CornerRadius="12" Margin="1,3,1,-1" />
     <Border x:Name="Face" CornerRadius="12" BorderBrush="#B8CBE9" BorderThickness="0.7">
      <Border.Background><StaticResource ResourceKey="PearlBrush" /></Border.Background>
      <Border BorderBrush="#EFFFFFFF" BorderThickness="1" CornerRadius="11" Margin="1">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
     </Border>
     <Border x:Name="Glint" Background="#90FFFFFF" CornerRadius="12" Opacity="0" IsHitTestVisible="False" />
     <Border x:Name="FocusRing" BorderBrush="#819DDC" BorderThickness="1.2" CornerRadius="14" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True">
      <Setter TargetName="Glint" Property="Opacity" Value="0.3" />
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="ButtonMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.045" Duration="0:0:0.12" />
       <DoubleAnimation Storyboard.TargetName="ButtonMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.045" Duration="0:0:0.12" />
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="ButtonMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16" />
       <DoubleAnimation Storyboard.TargetName="ButtonMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16" />
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsPressed" Value="True">
      <Setter TargetName="Face" Property="Opacity" Value="0.78" />
      <Trigger.EnterActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="ButtonMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.94" Duration="0:0:0.07" />
       <DoubleAnimation Storyboard.TargetName="ButtonMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.94" Duration="0:0:0.07" />
      </Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard>
       <DoubleAnimation Storyboard.TargetName="ButtonMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14" />
       <DoubleAnimation Storyboard.TargetName="ButtonMotion" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14" />
      </Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="4" /><Setter Property="MinWidth" Value="4" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True">
     <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#CED3DE" CornerRadius="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TaskToolButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Width" Value="27" /><Setter Property="Height" Value="28" />
   <Setter Property="Margin" Value="1,0" /><Setter Property="Foreground" Value="{Binding Color, Converter={StaticResource TaskColor}}" />
  </Style>
 </Window.Resources>

 <!-- The host changes size only at transition boundaries. Transparent space receives no hits. -->
 <Canvas>
  <infra:FluidSurface x:Name="Surface" Width="120" Height="52"
   MouseLeftButtonUp="Surface_MouseLeftButtonUp" MouseRightButtonUp="Surface_MouseRightButtonUp" />
  <Border x:Name="CapsuleHitTarget" Canvas.Left="10" Canvas.Top="10" Width="100" Height="32"
   Background="Transparent" CornerRadius="16" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
   MouseEnter="Capsule_MouseEnter" MouseLeave="Capsule_MouseLeave"
   MouseLeftButtonDown="Capsule_MouseLeftButtonDown" MouseMove="Capsule_MouseMove"
   MouseLeftButtonUp="Capsule_MouseLeftButtonUp" LostMouseCapture="Capsule_LostMouseCapture"
   MouseRightButtonUp="Surface_MouseRightButtonUp" ToolTip="点击展开 · 拖动移动 · 右键设置">
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
    <TextBlock Text="plan" FontSize="14.5" Foreground="#39445D" VerticalAlignment="Center" />
    <TextBlock Text="{Binding TodaySummary}" FontSize="12" Foreground="#74829D" VerticalAlignment="Center" Margin="4,1,0,0" />
   </StackPanel>
  </Border>

  <infra:StableContentGrid x:Name="ContentRoot" Canvas.Left="10" Canvas.Top="10" Width="312" Height="200"
   Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
   <Grid Margin="18,16,18,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="29" /><ColumnDefinition Width="*" /><ColumnDefinition Width="29" />
     </Grid.ColumnDefinitions>
     <Grid Grid.Column="1" Width="218" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="166" /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Style="{StaticResource IconButton}" Width="26" Height="26" Command="{Binding PreviousDayCommand}" ToolTip="前一天" AutomationProperties.Name="前一天">
       <Path Data="M9 2 L4 7 L9 12" Style="{StaticResource LineIcon}" Width="8" Height="11" />
      </Button>
     <Grid Grid.Column="1" ToolTip="{Binding DateHint}" Width="166" HorizontalAlignment="Center">
      <Border Background="{StaticResource PearlBrush}" BorderBrush="#D5DDF0" BorderThickness="0.5" CornerRadius="8" Visibility="{Binding IsToday, Converter={StaticResource BooleanVisibility}}" />
      <Rectangle Fill="#F1F5FE" Stroke="#C3D0EA" StrokeThickness="0.9" StrokeDashArray="2,3" RadiusX="8" RadiusY="8" Visibility="{Binding IsFuture, Converter={StaticResource BooleanVisibility}}" />
      <TextBlock x:Name="DateHeading" Text="{Binding DateTitle}" FontSize="17" FontWeight="Bold" Margin="4,0"
       TextAlignment="Center" VerticalAlignment="Center" MouseRightButtonUp="Surface_MouseRightButtonUp">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#5A6F99" /><Style.Triggers>
        <DataTrigger Binding="{Binding IsPast}" Value="True"><Setter Property="Foreground" Value="#939DAF" /><Setter Property="Opacity" Value="0.85" /></DataTrigger>
        <DataTrigger Binding="{Binding IsFuture}" Value="True"><Setter Property="Foreground" Value="#8195BB" /></DataTrigger>
       </Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
      <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" Command="{Binding NextDayCommand}" ToolTip="后一天" AutomationProperties.Name="后一天">
       <Path Data="M4 2 L9 7 L4 12" Style="{StaticResource LineIcon}" Width="8" Height="11" />
      </Button>
     </Grid>
      <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="3,0,0,0" Click="SettingsButton_Click" ToolTip="设置" AutomationProperties.Name="设置">
       <TextBlock Text="···" FontSize="17" Foreground="#8693A9" Margin="0,-3,0,0" />
      </Button>
    </Grid>
    <Grid Grid.Row="1" MinHeight="60" Margin="-5,14,-5,14">
     <TextBlock Text="暂无待办" FontSize="13.5" Foreground="#BDC4D1" HorizontalAlignment="Center" VerticalAlignment="Center"
      Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}" />
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ItemsControl x:Name="TaskList" ItemsSource="{Binding Items}" IsEnabled="{Binding CanSave}">
       <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
        <Grid x:Name="TaskRow" MinHeight="52">
         <Border x:Name="RowSurface" Background="Transparent" CornerRadius="12" Margin="0,1" />
         <infra:TaskEmphasisSurface x:Name="EmphasisSurface" IsEmphasized="{Binding EmphasisActive}" Tint="{Binding Color, Converter={StaticResource TaskColor}}" />
         <Grid x:Name="DisplayRow" Margin="4,10,1,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource TaskCheckBox}" IsChecked="{Binding IsCompleted, Mode=TwoWay}"
           Foreground="{Binding Color, Converter={StaticResource TaskColor}}" ToolTip="标记完成" AutomationProperties.Name="完成任务" />
          <TextBlock Grid.Column="1" Text="{Binding Title}" ToolTip="{Binding Detail}" FontSize="17" FontWeight="Bold"
           Foreground="{Binding Color, Converter={StaticResource TaskColor}}" TextWrapping="Wrap"
           VerticalAlignment="Center" Margin="5,0,2,0">
           <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
            <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough" /><Setter Property="Opacity" Value="0.5" /></DataTrigger>
           </Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Border x:Name="RowActions" Grid.Column="2" Visibility="Hidden" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource PearlLightBrush}" BorderBrush="#D6E0F0" BorderThickness="0.7" CornerRadius="13" Padding="3" Opacity="0">
           <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource TaskToolButton}" ToolTip="{Binding ImportanceHint}" AutomationProperties.Name="突出重要任务" Command="{Binding ToggleImportanceCommand}">
           <Path Data="M8 1 L10 5.3 L14.8 6 L11.3 9.4 L12.1 14.2 L8 11.9 L3.9 14.2 L4.7 9.4 L1.2 6 L6 5.3 Z" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Color, Converter={StaticResource TaskColor}}" StrokeThickness="1.2" StrokeLineJoin="Round">
            <Path.Style><Style TargetType="Path"><Setter Property="Fill" Value="Transparent" /><Setter Property="Opacity" Value="0.8" /><Style.Triggers><DataTrigger Binding="{Binding IsImportant}" Value="True"><Setter Property="Fill" Value="{Binding Color, Converter={StaticResource TaskColor}}" /><Setter Property="Opacity" Value="1" /></DataTrigger></Style.Triggers></Style></Path.Style>
           </Path>
          </Button>
           <Button Style="{StaticResource TaskToolButton}" ToolTip="编辑" AutomationProperties.Name="编辑任务" Command="{Binding EditCommand}"><Path Data="M2 10 L2 13 L5 13 L13 5 L10 2 Z M8.5 3.5 L11.5 6.5" Style="{StaticResource LineIcon}" /></Button>
           <Button Style="{StaticResource TaskToolButton}" ToolTip="删除" AutomationProperties.Name="删除任务" Command="{Binding DeleteCommand}"><Path Data="M3 4 L12 4 M6 2 L9 2 M4 4 L4.8 13 L10.2 13 L11 4 M6.5 6.5 L6.5 10.5 M8.5 6.5 L8.5 10.5" Style="{StaticResource LineIcon}" /></Button>
           </StackPanel>
          </Border>
          <Grid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="TaskContextMenu_Opened" Closed="TaskContextMenu_Closed">
           <MenuItem Header="编辑" Command="{Binding EditCommand}" /><MenuItem Header="重点突出" IsCheckable="True" IsChecked="{Binding IsImportant, Mode=TwoWay}" /><MenuItem Header="今天继续" Command="{Binding MoveToTodayCommand}" Visibility="{Binding CanMoveToToday, Converter={StaticResource BooleanVisibility}}" />
           <Separator /><MenuItem Header="删除" Command="{Binding DeleteCommand}" />
          </ContextMenu></Grid.ContextMenu>
         </Grid>
         <Grid x:Name="EditRow" Visibility="Collapsed" Margin="8,9">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" KeyDown="TaskEditTextBox_KeyDown"
           IsVisibleChanged="TaskEditTextBox_IsVisibleChanged" FontSize="17" FontWeight="Bold" MaxLength="160"
           Foreground="{Binding Color, Converter={StaticResource TaskColor}}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Margin="0,0,4,0" />
          <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="34" Command="{Binding SaveEditCommand}"><TextBlock Text="保存" FontSize="11" /></Button>
          <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="34" Command="{Binding CancelEditCommand}"><TextBlock Text="取消" FontSize="11" Foreground="#9FA8B8" /></Button>
         </Grid>
        </Grid>
        <DataTemplate.Triggers>
         <Trigger SourceName="TaskRow" Property="IsMouseOver" Value="True">
          <Setter TargetName="RowSurface" Property="Background" Value="#F3F6FB" /><Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
          <Setter TargetName="RowActions" Property="Opacity" Value="1" />
          <Trigger.EnterActions><BeginStoryboard x:Name="ShowTools"><Storyboard><DoubleAnimation Storyboard.TargetName="RowActions" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" FillBehavior="Stop" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><StopStoryboard BeginStoryboardName="ShowTools" /></Trigger.ExitActions>
         </Trigger>
         <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter TargetName="DisplayRow" Property="Visibility" Value="Collapsed" /><Setter TargetName="EditRow" Property="Visibility" Value="Visible" /></DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </Grid>
    <Grid Grid.Row="2" Height="44">
     <Border x:Name="InputBackdrop" Background="#EFF2F8" BorderBrush="#08000000" BorderThickness="0.6"
      CornerRadius="14" Padding="12,8,45,8" Visibility="Hidden" Opacity="0" IsHitTestVisible="False">
      <Grid>
       <TextBox x:Name="NewTaskBox" Text="{Binding NewTaskText, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewTaskBox_KeyDown"
        FontSize="16" FontWeight="Bold" MaxLength="160" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Foreground="#58647F" AutomationProperties.Name="新增待办" />
       <TextBlock Text="添加待办…" FontSize="15" Foreground="#ADB7CA" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="{Binding NewTaskText, Converter={StaticResource EmptyStringVisibility}}" />
      </Grid>
     </Border>
     <Button x:Name="AddToggleButton" Style="{StaticResource AddButton}" IsEnabled="{Binding CanSave}" Click="AddToggleButton_Click"
      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="添加待办" AutomationProperties.Name="新增任务">
      <Path Data="M6 1 L6 11 M1 6 L11 6" Stroke="#6C7DB1" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" />
     </Button>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#AC644E" FontSize="11" TextWrapping="Wrap">
     <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding StatusMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
  </infra:StableContentGrid>
 </Canvas>
</Window>
