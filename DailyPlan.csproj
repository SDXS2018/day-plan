<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DailyPlan</AssemblyName>
    <RootNamespace>DailyPlan</RootNamespace>
    <Version>1.1.1</Version>
    <StartupObject>DailyPlan.App</StartupObject>
    <ApplicationIcon>Assets\DailyPlan.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Compile Remove="Tests\**\*.cs" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <EmbeddedResource Include="Assets\DailyPlan.ico" LogicalName="DailyPlan.TrayIcon" />
    <Content Include="Assets\Fonts\PlanRounded.ttf" CopyToOutputDirectory="PreserveNewest" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <None Update="Assets\Fonts\OFL-License.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Licenses\Velopack-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
