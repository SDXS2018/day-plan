<Window x:Class="DailyPlan.UpdateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="软件更新 · plan" Width="430" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="{StaticResource AppFont}" FontWeight="Bold" FontSize="14">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanVisibility" /></Window.Resources>
 <Border Background="{StaticResource PearlLightBrush}" BorderBrush="#CCD8ED" BorderThickness="1" CornerRadius="22" Margin="5" Padding="25">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
    <TextBlock Text="软件更新" FontSize="23" Foreground="#526B94" VerticalAlignment="Center" />
    <Button Style="{StaticResource IconButton}" Content="×" FontSize="24" HorizontalAlignment="Right" Click="CloseButton_Click" AutomationProperties.Name="关闭更新窗口" />
   </Grid>
   <TextBlock Grid.Row="1" Text="{Binding VersionText}" Foreground="#9AA9C0" FontSize="12" Margin="0,10,0,0" />
   <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="#6F84A7" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,16" LineHeight="24" />
   <StackPanel Grid.Row="3" Visibility="{Binding IsDownloading, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,15">
    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" Height="5" Foreground="#9CB8E8" Background="#E4EBF6" BorderThickness="0" />
    <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#91A4C1" Margin="0,7,0,0" />
   </StackPanel>
   <StackPanel Grid.Row="4">
    <Button x:Name="UpdateActionButton" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Style="{StaticResource PearlButton}" Width="170" Height="38" HorizontalAlignment="Right" Click="ActionButton_Click" AutomationProperties.Name="执行更新操作" />
    <TextBlock Text="启动后自动检查，每24小时一次 · 任务数据保留" FontSize="10" Foreground="#A3B0C5" Margin="0,15,0,0" HorizontalAlignment="Center" />
   </StackPanel>
  </Grid>
 </Border>
</Window>
