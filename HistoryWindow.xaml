<Window x:Class="DailyPlan.HistoryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:infra="clr-namespace:DailyPlan.Infrastructure"
 Title="工作回顾 · plan" Width="1180" Height="820" MinWidth="900" MinHeight="640"
 WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterOwner"
 Background="#F7F8FC" FontFamily="{StaticResource AppFont}" FontWeight="Bold" FontSize="15"
 TextOptions.TextFormattingMode="Display" PreviewKeyDown="Window_PreviewKeyDown">
 <Window.Resources>
  <infra:TaskColorConverter x:Key="TaskColor" />
  <infra:CalendarPreviewVisibilityConverter x:Key="PreviewVisibility" />
  <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
  <Style x:Key="PeriodButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Width" Value="88" /><Setter Property="Height" Value="34" />
   <Setter Property="Foreground" Value="#8B99AE" /><Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="DayButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand" /><Setter Property="Margin" Value="3" />
   <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
   <Setter Property="Background" Value="#FCFDFF" /><Setter Property="BorderBrush" Value="#ECF0F7" />
   <Setter Property="BorderThickness" Value="0.7" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" Padding="9,7" RenderTransformOrigin="0.5,0.5">
     <ContentPresenter />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource PearlLightBrush}" /><Setter TargetName="Face" Property="BorderBrush" Value="#BCCFE9" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#829FD2" /></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.7" /><Setter TargetName="Face" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.975" ScaleY="0.975" /></Setter.Value></Setter></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers>
    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Opacity" Value="0.35" /></DataTrigger>
    <DataTrigger Binding="{Binding IsInRange}" Value="False"><Setter Property="Opacity" Value="0.4" /></DataTrigger>
    <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{StaticResource PearlBrush}" /></DataTrigger>
    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#91AAD4" /><Setter Property="BorderThickness" Value="1.4" /><Setter Property="Opacity" Value="1" /></DataTrigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="30,26" MaxWidth="1460">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Margin="0,0,0,23" MouseLeftButtonDown="Header_MouseLeftButtonDown">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="工作回顾" FontSize="28" Foreground="#465976" />
    <TextBlock Text="把每一天，轻轻记下来。" FontSize="12" Foreground="#A0ABC0" Margin="1,7,0,0" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Border Background="White" CornerRadius="13" BorderBrush="#E2E8F3" BorderThickness="0.7" Padding="4" Margin="0,0,15,0">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="CalendarModeButton" Content="按月查看" Command="{Binding CalendarCommand}" AutomationProperties.Name="按月查看">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PeriodButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCalendarMonth}" Value="True"><Setter Property="Background" Value="{StaticResource PearlBrush}" /><Setter Property="Foreground" Value="#5D739E" /></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      <Button x:Name="WeekButton" Content="最近7天" Command="{Binding WeekCommand}" AutomationProperties.Name="最近7天">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PeriodButton}"><Style.Triggers><DataTrigger Binding="{Binding IsWeek}" Value="True"><Setter Property="Background" Value="{StaticResource PearlBrush}" /><Setter Property="Foreground" Value="#5D739E" /></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
      <Button x:Name="MonthButton" Content="最近30天" Command="{Binding MonthCommand}" AutomationProperties.Name="最近30天">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PeriodButton}"><Style.Triggers><DataTrigger Binding="{Binding IsMonth}" Value="True"><Setter Property="Background" Value="{StaticResource PearlBrush}" /><Setter Property="Foreground" Value="#5D739E" /></DataTrigger></Style.Triggers></Style></Button.Style>
      </Button>
     </StackPanel>
    </Border>
    <Button Style="{StaticResource IconButton}" Width="38" Height="38" Content="□" ToolTip="窗口 / 全屏 · F11" AutomationProperties.Name="切换全屏" Click="FullScreenButton_Click" />
    <Button Style="{StaticResource IconButton}" Width="38" Height="38" Content="×" FontSize="25" ToolTip="关闭回顾" AutomationProperties.Name="关闭工作回顾" Click="CloseButton_Click" />
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="2,0,0,24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="{Binding PeriodLabel}" FontSize="12" Foreground="#8D9BB3" />
    <TextBlock Text="{Binding Report.RangeText}" FontSize="12" Foreground="#A8B2C3" Margin="0,5,0,0" />
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="{Binding Report.CompletedCount}" FontSize="25" Foreground="#4385CE" /><TextBlock Text=" 完成" FontSize="12" Foreground="#9DAAC0" VerticalAlignment="Center" Margin="0,0,24,0" />
    <TextBlock Text="{Binding Report.PendingCount}" FontSize="25" Foreground="#C17D9C" /><TextBlock Text=" 当前待办" FontSize="12" Foreground="#9DAAC0" VerticalAlignment="Center" Margin="0,0,24,0" />
    <TextBlock Text="{Binding Report.CreatedCount}" FontSize="25" Foreground="#9674C4" /><TextBlock Text=" 新增" FontSize="12" Foreground="#9DAAC0" VerticalAlignment="Center" />
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="290" /></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="23" Padding="17" BorderBrush="#EDF0F7" BorderThickness="0.7">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <Grid Margin="8,2,4,17">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding MonthTitle}" FontSize="21" Foreground="#596E90" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button Content="‹" FontSize="23" Width="31" Height="31" Style="{StaticResource IconButton}" Command="{Binding PreviousMonthCommand}" AutomationProperties.Name="上个月" />
       <Button Content="今天" FontSize="12" Width="51" Height="31" Margin="4,0" Style="{StaticResource PearlButton}" Command="{Binding TodayCommand}" AutomationProperties.Name="回到本月今天" />
       <Button Content="›" FontSize="23" Width="31" Height="31" Style="{StaticResource IconButton}" Command="{Binding NextMonthCommand}" AutomationProperties.Name="下个月" />
      </StackPanel>
     </Grid>
     <UniformGrid Grid.Row="1" Columns="7" Margin="3,0" TextBlock.FontSize="12" TextBlock.Foreground="#A6B2C6">
      <TextBlock Text="一" HorizontalAlignment="Center" /><TextBlock Text="二" HorizontalAlignment="Center" /><TextBlock Text="三" HorizontalAlignment="Center" /><TextBlock Text="四" HorizontalAlignment="Center" /><TextBlock Text="五" HorizontalAlignment="Center" /><TextBlock Text="六" HorizontalAlignment="Center" /><TextBlock Text="日" HorizontalAlignment="Center" />
     </UniformGrid>
     <ItemsControl x:Name="CalendarGrid" Grid.Row="2" ItemsSource="{Binding CalendarDays}" MinHeight="348">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button x:Name="DayCell" Style="{StaticResource DayButton}" Click="DayButton_Click" AutomationProperties.Name="{Binding AccessibleName}">
        <Grid ClipToBounds="True">
         <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Number}" FontSize="18" Foreground="#7D8DA8">
           <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="FontSize" Value="20" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="10" Foreground="#8B9DBB" VerticalAlignment="Center" />
         </Grid>
         <ItemsControl Grid.Row="1" ItemsSource="{Binding Preview}" Margin="0,5,0,0" VerticalAlignment="Top" Visibility="{Binding ActualHeight, ElementName=DayCell, Converter={StaticResource PreviewVisibility}}">
          <ItemsControl.ItemTemplate><DataTemplate>
           <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="7" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Ellipse Width="4" Height="4" Fill="{Binding Color, Converter={StaticResource TaskColor}}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding Color, Converter={StaticResource TaskColor}}" FontSize="10.5" TextTrimming="CharacterEllipsis" Opacity="0.8" />
           </Grid>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </Grid>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </Grid>
   </Border>
   <Border Grid.Column="2" Background="{StaticResource PearlLightBrush}" CornerRadius="23" BorderBrush="#E0E7F2" BorderThickness="0.7" Padding="23">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <TextBlock Text="{Binding SelectedDateText}" Foreground="#62779C" FontSize="19" />
     <TextBlock Grid.Row="1" Text="{Binding SelectedSummary}" Foreground="#A0ACC0" FontSize="12" Margin="0,10,0,20" />
     <Grid Grid.Row="2">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsSelectedEmpty, Converter={StaticResource BooleanVisibility}}">
       <TextBlock Text="这一天，留白也很好。" Foreground="#ACB7CB" FontSize="13" TextAlignment="Center" />
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ItemsControl x:Name="DayTaskList" ItemsSource="{Binding SelectedTasks}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="#BFFFFFFF" CornerRadius="13" Padding="12,13" Margin="0,0,0,11">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <CheckBox Style="{StaticResource TaskCheckBox}" IsChecked="{Binding IsCompleted, Mode=OneWay}" Foreground="{Binding Color, Converter={StaticResource TaskColor}}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Margin="5,1,0,0">
           <TextBlock Text="{Binding Title}" Foreground="{Binding Color, Converter={StaticResource TaskColor}}" FontSize="16" TextWrapping="Wrap" />
           <TextBlock Text="{Binding StateText}" Foreground="#ABB5C7" FontSize="11" Margin="0,6,0,0" />
          </StackPanel>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
     </Grid>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" Text="点击日期查看当天任务 · 数字为完成 / 总数 · 未完成事项自动延续" FontSize="11" Foreground="#ADB7C9" HorizontalAlignment="Center" Margin="0,17,0,0" />
 </Grid>
</Window>
